# Bu dosyayi .env olarak kopyala ve anahtarlari doldur.
# En az birini doldurman yeterli; ikisi de doluysa uretim ikiye bolunur.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Alternatifler (kaliteden ucuza): gpt-5-mini > o4-mini > gpt-4.1-mini > gpt-4o-mini
# nano ve codex modelleri bu is icin onerilmez.
# OPENAI_BASE_URL=            # sadece proxy/uyumlu servis kullaniyorsan

# --- Gemini (OpenAI uyumlu endpoint uzerinden) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Hugging Face (veri setini yuklemek icin) ---
# huggingface.co/settings/tokens -> "write" yetkili token
HF_TOKEN=

# --- Uretim ayarlari ---
DEFAULT_PROVIDER=openai  # openai | gemini | both  ("both" ikisine paylastirir)
DATASET_LANG=tr          # tr | en
TEMPERATURE=1.0
MAX_TOKENS=16000         # reasoning modeller dusunme icin de token harcar
REASONING_EFFORT=medium  # minimal | low | medium | high (sadece gpt-5*/o* ailesi)
# Bu ikisi FARKLI eksendir:
#   QUESTION_BATCH_SIZE = bir turda / tek istekte kac SORU uretilir
#   WORKERS             = ayni anda kac ISTEK ucar (paralellik)
# 'run' komutu WORKERS'i doldurmak icin turlari dalga halinde birlestirir:
#   dalga basi tur = WORKERS // QUESTION_BATCH_SIZE
# Isci bosta kalmasin diye WORKERS'i BATCH_SIZE'in KATI sec:
#   BATCH=5 icin WORKERS 5, 10, 15, 20...   (12 secersen 2 isci bosta kalir)
WORKERS=10               # paralel istek sayisi (rate limit yersen dusur)
QUESTION_BATCH_SIZE=5    # tek istekte uretilecek soru sayisi
MAX_RETRIES=3
DATA_DIR=data
