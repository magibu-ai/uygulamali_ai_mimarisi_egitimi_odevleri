{"id": "MIHENK-GRAPH-TR-L2-0015", "language": "tr", "discipline": "Grafik Analizi", "format": "short_answer", "difficulty": "L2", "question": "Çizgi grafikte satışlar 2020=300, 2021=360'tır. Bir yıllık artış yüzde kaçtır? (sayı)", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["%20", "20%"], "explanation": "Increase = (360 − 300) / 300 = 60 / 300 = 20%.", "tags": ["grafik-okuma", "yüzde-değişim"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
