{"id": "MIHENK-GEO-TR-L3-0017", "language": "tr", "discipline": "Coğrafya", "format": "short_answer", "difficulty": "L3", "question": "Kuzeye 6 km, sonra batıya 8 km yürüyen birinin başlangıç noktasına kuş uçuşu uzaklığı kaç km'dir?", "choices": null, "answer": null, "answer_short": "10", "answer_aliases": ["10 km"], "explanation": "√(6² + 8²) = √100 = 10 km.", "tags": ["mekânsal-akıl-yürütme", "pisagor"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-GEO-TR-L3-0018", "language": "tr", "discipline": "Coğrafya", "format": "short_answer", "difficulty": "L3", "question": "Deniz seviyesinde 25°C olan bir yerde her 1000 m'de 5°C düşüş olursa 2000 m yükseklikte sıcaklık kaç °C olur?", "choices": null, "answer": null, "answer_short": "15", "answer_aliases": ["15 derece", "15°C"], "explanation": "Drop at 2000 m is 2 × 5 = 10°C; 25 − 10 = 15°C.", "tags": ["iklim", "yükselti-sıcaklık"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-GEO-TR-L4-0019", "language": "tr", "discipline": "Coğrafya", "format": "short_answer", "difficulty": "L4", "question": "Kaynağı 900 m, ağzı 100 m yükseklikte olan 200 km uzunluğundaki bir nehrin ortalama eğimi kaç m/km'dir?", "choices": null, "answer": null, "answer_short": "4", "answer_aliases": ["4 m/km"], "explanation": "Gradient = (900 − 100) / 200 = 800 / 200 = 4 m/km.", "tags": ["eğim", "hesaplama"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
