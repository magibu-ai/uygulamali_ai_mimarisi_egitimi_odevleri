{"id": "MIHENK-PHYS-EN-L1-0011", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L1", "question": "The speed of light in vacuum is approximately how many thousand km/s? (number)", "choices": null, "answer": null, "answer_short": "300", "answer_aliases": ["300000", "300,000", "three hundred thousand"], "explanation": "Light travels at about 300,000 km/s in vacuum, i.e. 300 thousand km/s.", "tags": ["light", "constant"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L1-0012", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L1", "question": "What is the SI unit of force? (unit name)", "choices": null, "answer": null, "answer_short": "Newton", "answer_aliases": ["newton", "N"], "explanation": "The SI unit of force is the newton (N).", "tags": ["unit", "force"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L1-0013", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L1", "question": "A force of 4 N acts over a distance of 5 m. How much work is done, in joules?", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["20 J"], "explanation": "Work = force × distance = 4 × 5 = 20 J.", "tags": ["work", "calculation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0014", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L2", "question": "A 3 kg object moves at 5 m/s. What is its momentum in kg·m/s?", "choices": null, "answer": null, "answer_short": "15", "answer_aliases": ["15 kg·m/s"], "explanation": "Momentum p = m × v = 3 × 5 = 15 kg·m/s.", "tags": ["momentum", "calculation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0015", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L2", "question": "A motor does 200 J of work in 5 s. What is its power in watts? (P = work / time)", "choices": null, "answer": null, "answer_short": "40", "answer_aliases": ["40 W"], "explanation": "Power = work / time = 200 / 5 = 40 W.", "tags": ["power", "calculation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0016", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L2", "question": "Two resistors, 10 Ω and 15 Ω, are connected in series. What is the total resistance in ohms?", "choices": null, "answer": null, "answer_short": "25", "answer_aliases": ["25 Ω", "25 ohm"], "explanation": "In series, resistances add: 10 + 15 = 25 Ω.", "tags": ["resistance", "series"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L3-0017", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L3", "question": "An object accelerates from rest at 4 m/s² for 5 seconds. What speed does it reach, in m/s?", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["20 m/s"], "explanation": "v = a × t = 4 × 5 = 20 m/s.", "tags": ["accelerated-motion", "speed"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L3-0018", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L3", "question": "An object is dropped and hits the ground after 3 s (g = 10 m/s²). From what height was it dropped, in meters? (h = ½gt²)", "choices": null, "answer": null, "answer_short": "45", "answer_aliases": ["45 m"], "explanation": "h = ½ × 10 × 3² = 5 × 9 = 45 m.", "tags": ["free-fall", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L4-0019", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L4", "question": "An object with kinetic energy 36 J has a mass of 2 kg. What is its speed in m/s? (KE = ½mv²)", "choices": null, "answer": null, "answer_short": "6", "answer_aliases": ["6 m/s"], "explanation": "36 = ½ × 2 × v² = v² → v = 6 m/s.", "tags": ["kinetic-energy", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-PHYS-EN-L4-0020", "language": "en", "discipline": "Fizik", "format": "short_answer", "difficulty": "L4", "question": "A 5 kg object moving at 4 m/s collides with and sticks to a 3 kg object at rest. What is their common speed in m/s?", "choices": null, "answer": null, "answer_short": "2.5", "answer_aliases": ["2,5", "2.5 m/s"], "explanation": "Momentum: (5 × 4) = (5 + 3) × v → 20 = 8v → v = 2.5 m/s.", "tags": ["momentum-conservation", "inelastic-collision"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
