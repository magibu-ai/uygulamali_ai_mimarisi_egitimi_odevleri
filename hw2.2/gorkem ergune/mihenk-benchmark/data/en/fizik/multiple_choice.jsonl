{"id": "MIHENK-PHYS-EN-L1-0001", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L1", "question": "An object moves at a constant 8 m/s for 6 seconds. What distance does it cover?", "choices": {"A": "48", "B": "1.33", "C": "14", "D": "2"}, "answer": "A", "answer_short": null, "explanation": "At constant speed, distance = speed × time = 8 × 6 = 48 m.", "tags": ["motion", "constant-speed"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L1-0002", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L1", "question": "What is the SI unit of energy?", "choices": {"A": "Newton", "B": "Joule", "C": "Watt", "D": "Pascal"}, "answer": "B", "answer_short": null, "explanation": "The SI unit of energy is the joule (J). Newton is force, watt is power, pascal is pressure.", "tags": ["unit", "energy"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L1-0003", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L1", "question": "An object has a mass of 5 kg. What is its weight? (g = 10 m/s²)", "choices": {"A": "0.5", "B": "5", "C": "50", "D": "500"}, "answer": "C", "answer_short": null, "explanation": "Weight W = m × g = 5 × 10 = 50 N.", "tags": ["weight", "mass"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0004", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L2", "question": "A 3 kg mass on a frictionless surface experiences a 12 N force. What is its acceleration?", "choices": {"A": "4", "B": "36", "C": "9", "D": "0.25"}, "answer": "A", "answer_short": null, "explanation": "Newton's second law: a = F / m = 12 / 3 = 4 m/s².", "tags": ["newtons-law", "acceleration"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0005", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L2", "question": "A 2 kg object moves at 4 m/s. What is its kinetic energy?", "choices": {"A": "16", "B": "8", "C": "4", "D": "32"}, "answer": "A", "answer_short": null, "explanation": "KE = ½ m v² = ½ × 2 × 4² = ½ × 2 × 16 = 16 J.", "tags": ["kinetic-energy", "calculation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L2-0006", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L2", "question": "An object is dropped from rest (g = 10 m/s²). What is its speed after 4 seconds?", "choices": {"A": "10", "B": "40", "C": "4", "D": "400"}, "answer": "B", "answer_short": null, "explanation": "In free fall v = g × t = 10 × 4 = 40 m/s.", "tags": ["free-fall", "speed"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L3-0007", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L3", "question": "A car accelerates from rest at 3 m/s² for 4 seconds. How far does it travel?", "choices": {"A": "12", "B": "24", "C": "48", "D": "6"}, "answer": "B", "answer_short": null, "explanation": "From rest: x = ½ a t² = ½ × 3 × 4² = ½ × 3 × 16 = 24 m.", "tags": ["accelerated-motion", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-PHYS-EN-L3-0008", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L3", "question": "A circuit has a 20 V supply and a 5 Ω resistor. What is the current? (I = V / R)", "choices": {"A": "4", "B": "100", "C": "25", "D": "0.25"}, "answer": "A", "answer_short": null, "explanation": "Ohm's law: I = V / R = 20 / 5 = 4 A. (100 is V × R, which is wrong.)", "tags": ["ohms-law", "current"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L4-0009", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L4", "question": "An object is dropped from a height of 45 m (g = 10 m/s², no friction). What is its speed when it hits the ground?", "choices": {"A": "30", "B": "45", "C": "90", "D": "900"}, "answer": "A", "answer_short": null, "explanation": "Using v² = 2gh: v = √(2 × 10 × 45) = √900 = 30 m/s.", "tags": ["energy-conservation", "free-fall", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-PHYS-EN-L4-0010", "language": "en", "discipline": "Fizik", "format": "multiple_choice", "difficulty": "L4", "question": "A 2 kg object moving at 6 m/s collides with and sticks to a 4 kg object at rest (inelastic collision). What is their common velocity?", "choices": {"A": "2", "B": "3", "C": "1", "D": "12"}, "answer": "A", "answer_short": null, "explanation": "Conservation of momentum: (2 × 6) + (4 × 0) = (2 + 4) × v → 12 = 6v → v = 2 m/s.", "tags": ["momentum-conservation", "inelastic-collision"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
