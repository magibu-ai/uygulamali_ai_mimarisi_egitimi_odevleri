{"id": "MIHENK-MATH-EN-L1-0011", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L1", "question": "What is the greatest common divisor (GCD) of 24 and 36?", "choices": null, "answer": null, "answer_short": "12", "answer_aliases": [], "explanation": "24 = 2³×3, 36 = 2²×3². Common factors: 2²×3 = 12.", "tags": ["gcd", "divisibility"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L1-0012", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L1", "question": "How many degrees are there in a right angle?", "choices": null, "answer": null, "answer_short": "90", "answer_aliases": ["90 degrees", "90°"], "explanation": "A right angle measures exactly 90 degrees.", "tags": ["geometry", "angle"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L1-0013", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L1", "question": "What is the value of 5 squared plus 2 cubed?", "choices": null, "answer": null, "answer_short": "33", "answer_aliases": [], "explanation": "5² = 25 and 2³ = 8; their sum is 25 + 8 = 33.", "tags": ["exponents", "order-of-operations"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L2-0014", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L2", "question": "Three consecutive integers add up to 60. What is the smallest of them?", "choices": null, "answer": null, "answer_short": "19", "answer_aliases": [], "explanation": "The middle integer is 60/3 = 20, so the integers are 19, 20, 21; the smallest is 19.", "tags": ["consecutive-integers", "equation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L2-0015", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L2", "question": "Pipe A fills a tank in 4 hours and pipe B fills the same tank in 12 hours. Working together, how many hours does it take to fill the tank?", "choices": null, "answer": null, "answer_short": "3", "answer_aliases": ["3 hours"], "explanation": "1/4 + 1/12 = 3/12 + 1/12 = 4/12 = 1/3, so together they fill it in 3 hours.", "tags": ["work-rate", "fractions"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L2-0016", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L2", "question": "If 3x − 5 = 16, what is the value of x?", "choices": null, "answer": null, "answer_short": "7", "answer_aliases": [], "explanation": "3x = 16 + 5 = 21, so x = 7.", "tags": ["linear-equation", "solve-for-x"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L3-0017", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L3", "question": "How many positive divisors does 360 have?", "choices": null, "answer": null, "answer_short": "24", "answer_aliases": [], "explanation": "360 = 2³ × 3² × 5. Number of divisors = (3+1)(2+1)(1+1) = 4 × 3 × 2 = 24.", "tags": ["divisor-count", "prime-factorization"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L3-0018", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L3", "question": "If 30% of a number is 21, what is 50% of the same number?", "choices": null, "answer": null, "answer_short": "35", "answer_aliases": [], "explanation": "The number is 21 / 0.30 = 70, and 50% of 70 is 35.", "tags": ["percentage", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MATH-EN-L4-0019", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L4", "question": "How many integers from 1 to 100 inclusive are divisible by 4 or by 6?", "choices": null, "answer": null, "answer_short": "33", "answer_aliases": [], "explanation": "Divisible by 4: 25 numbers; by 6: 16 numbers; by 12 (both): 8 numbers. Inclusion–exclusion: 25 + 16 − 8 = 33.", "tags": ["inclusion-exclusion", "counting"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-MATH-EN-L4-0020", "language": "en", "discipline": "Matematik", "format": "short_answer", "difficulty": "L4", "question": "In a geometric sequence the third term is 20 and the fifth term is 80. What is the first term? (The common ratio is positive.)", "choices": null, "answer": null, "answer_short": "5", "answer_aliases": [], "explanation": "r² = 80/20 = 4, so r = 2. Third term = a·r² = 20 → a·4 = 20 → a = 5.", "tags": ["geometric-sequence", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
