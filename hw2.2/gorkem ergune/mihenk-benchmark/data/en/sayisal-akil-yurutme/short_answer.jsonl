{"id": "MIHENK-NUM-EN-L4-0019", "language": "en", "discipline": "Sayısal Akıl Yürütme", "format": "short_answer", "difficulty": "L4", "question": "The average age of 4 people is 30. If a 20-year-old joins them, what is the new average age of the 5 people?", "choices": null, "answer": null, "answer_short": "28", "answer_aliases": [], "explanation": "Old total 4 × 30 = 120; new total 120 + 20 = 140; average = 140 / 5 = 28.", "tags": ["average", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
