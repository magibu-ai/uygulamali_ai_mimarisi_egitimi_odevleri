{"id": "MIHENK-GEO-EN-L3-0017", "language": "en", "discipline": "Coğrafya", "format": "short_answer", "difficulty": "L3", "question": "A person walks 9 km north then 12 km west. What is the straight-line distance back to the start? (km)", "choices": null, "answer": null, "answer_short": "15", "answer_aliases": ["15 km"], "explanation": "√(9² + 12²) = √225 = 15 km.", "tags": ["spatial-reasoning", "pythagoras"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
