{"id": "MIHENK-GRAPH-EN-L2-0014", "language": "en", "discipline": "Grafik Analizi", "format": "short_answer", "difficulty": "L2", "question": "Bar chart (Month: mm) — Jan 40, Feb 60, Mar 80. What is the total rainfall over the three months?", "choices": null, "answer": null, "answer_short": "180", "answer_aliases": ["180 mm"], "explanation": "40 + 60 + 80 = 180 mm.", "tags": ["chart-reading", "addition"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-GRAPH-EN-L2-0015", "language": "en", "discipline": "Grafik Analizi", "format": "short_answer", "difficulty": "L2", "question": "In a line chart, sales are 2020=300 and 2021=360. What is the one-year percentage increase? (number)", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["20%"], "explanation": "Increase = (360 − 300) / 300 = 60 / 300 = 20%.", "tags": ["chart-reading", "percent-change"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-GRAPH-EN-L2-0016", "language": "en", "discipline": "Grafik Analizi", "format": "short_answer", "difficulty": "L2", "question": "In a pie chart, the Rent slice is 50%. What percentage is everything else combined?", "choices": null, "answer": null, "answer_short": "50", "answer_aliases": ["50%"], "explanation": "Since the total is 100%, the rest is 100 − 50 = 50%.", "tags": ["pie-chart", "percentage"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-GRAPH-EN-L3-0017", "language": "en", "discipline": "Grafik Analizi", "format": "short_answer", "difficulty": "L3", "question": "In a distance-time graph, the reading is 0 m at 0 s and 100 m at 5 s (linear). What is the speed in m/s?", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["20 m/s"], "explanation": "Speed = 100 / 5 = 20 m/s.", "tags": ["chart-reading", "slope"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
