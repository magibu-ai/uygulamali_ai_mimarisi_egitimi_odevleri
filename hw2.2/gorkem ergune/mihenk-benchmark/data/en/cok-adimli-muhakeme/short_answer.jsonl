{"id": "MIHENK-MULTI-EN-L1-0011", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L1", "question": "A basket has 10 eggs. 4 eggs break, then 6 eggs are added. How many eggs are in the basket?", "choices": null, "answer": null, "answer_short": "12", "answer_aliases": [], "explanation": "10 − 4 = 6; 6 + 6 = 12 eggs.", "tags": ["two-step", "add-subtract"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L1-0012", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L1", "question": "Three more than half of a number is 8. What is the number?", "choices": null, "answer": null, "answer_short": "10", "answer_aliases": [], "explanation": "x/2 + 3 = 8 → x/2 = 5 → x = 10.", "tags": ["equation", "two-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L1-0013", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L1", "question": "At a shop, 4 pens cost 20. How much does 1 pen cost?", "choices": null, "answer": null, "answer_short": "5", "answer_aliases": [], "explanation": "20 / 4 = 5.", "tags": ["division", "unit-price"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L2-0014", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L2", "question": "A worker works 8 hours a day and makes 15 parts per hour. How many parts does the worker make in a day?", "choices": null, "answer": null, "answer_short": "120", "answer_aliases": [], "explanation": "8 × 15 = 120 parts.", "tags": ["multiplication", "two-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L2-0015", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L2", "question": "Two siblings' ages sum to 30 and differ by 6. How old is the older sibling?", "choices": null, "answer": null, "answer_short": "18", "answer_aliases": [], "explanation": "Older = (30 + 6) / 2 = 18.", "tags": ["age-problem", "equation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L2-0016", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L2", "question": "40% of a book has been read, and 90 pages remain. How many pages does the book have in total?", "choices": null, "answer": null, "answer_short": "150", "answer_aliases": [], "explanation": "The remaining 60% equals 90 pages: 90 / 0.60 = 150 pages.", "tags": ["percentage", "reverse"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L3-0017", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L3", "question": "From 200, first 10% is spent, then 50% of the remainder is spent. How much is left?", "choices": null, "answer": null, "answer_short": "90", "answer_aliases": [], "explanation": "First spend 20, leaving 180; then spend 180 × 0.50 = 90, leaving 90.", "tags": ["percentage", "sequential", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L3-0018", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L3", "question": "A vehicle travels 2 hours at 60 km/h, then 1 hour at 90 km/h. What total distance does it cover?", "choices": null, "answer": null, "answer_short": "210", "answer_aliases": ["210 km"], "explanation": "2 × 60 = 120 km; 1 × 90 = 90 km; total 120 + 90 = 210 km.", "tags": ["speed-distance", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-EN-L4-0019", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L4", "question": "A pool holds 600 liters and currently has 300 liters. A tap adds 20 liters per minute while a drain removes 5 liters per minute. In how many minutes will the pool be completely full?", "choices": null, "answer": null, "answer_short": "20", "answer_aliases": ["20 minutes"], "explanation": "Net fill rate is 20 − 5 = 15 L/min. It needs 600 − 300 = 300 L, so 300 / 15 = 20 minutes.", "tags": ["pool-problem", "net-rate", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-MULTI-EN-L4-0020", "language": "en", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L4", "question": "A shirt costs 80. First a 25% discount is applied, then a further 10% coupon on the reduced price. What is the final price?", "choices": null, "answer": null, "answer_short": "54", "answer_aliases": [], "explanation": "80 × 0.75 = 60; 60 × 0.90 = 54.", "tags": ["percentage", "sequential-discount", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
