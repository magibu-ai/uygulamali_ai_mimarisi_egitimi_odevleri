{"id": "MIHENK-CHEM-EN-L1-0001", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L1", "question": "What is the chemical formula of water?", "choices": {"A": "CO2", "B": "H2O", "C": "O2", "D": "NaCl"}, "answer": "B", "answer_short": null, "explanation": "Water consists of two hydrogen atoms and one oxygen atom: H2O.", "tags": ["formula", "basic"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L1-0002", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L1", "question": "The symbol 'Na' on the periodic table stands for which element?", "choices": {"A": "Nitrogen", "B": "Sodium", "C": "Nickel", "D": "Neon"}, "answer": "B", "answer_short": null, "explanation": "'Na' denotes sodium (from Latin 'natrium').", "tags": ["periodic-table", "symbol"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L1-0003", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L1", "question": "Which particle is NOT found in the nucleus of an atom?", "choices": {"A": "Proton", "B": "Neutron", "C": "Electron", "D": "Every nuclear particle is inside"}, "answer": "C", "answer_short": null, "explanation": "Protons and neutrons sit in the nucleus; electrons occupy shells around it.", "tags": ["atom", "particles"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L2-0004", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L2", "question": "When H2 + O2 → H2O is balanced, what is the coefficient of H2O?", "choices": {"A": "1", "B": "2", "C": "3", "D": "4"}, "answer": "B", "answer_short": null, "explanation": "The balanced equation is 2H2 + O2 → 2H2O, so the coefficient of H2O is 2.", "tags": ["balancing", "reaction"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L2-0005", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L2", "question": "A substance has a pH of 3. It is therefore:", "choices": {"A": "Acidic", "B": "Basic", "C": "Neutral", "D": "A salt solution"}, "answer": "A", "answer_short": null, "explanation": "pH < 7 is acidic, pH = 7 neutral, pH > 7 basic. pH 3 indicates an acidic solution.", "tags": ["ph", "acid-base"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L2-0006", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L2", "question": "How many moles are in 12 g of carbon? (molar mass of C is 12 g/mol)", "choices": {"A": "1", "B": "12", "C": "0.5", "D": "24"}, "answer": "A", "answer_short": null, "explanation": "Moles = mass / molar mass = 12 / 12 = 1 mol.", "tags": ["mole", "calculation"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L3-0007", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L3", "question": "In 2H2 + O2 → 2H2O, if 4 mol of H2 react completely, how many moles of water are produced?", "choices": {"A": "2", "B": "4", "C": "8", "D": "1"}, "answer": "B", "answer_short": null, "explanation": "The H2:H2O ratio is 2:2 = 1:1, so 4 mol H2 yields 4 mol water.", "tags": ["stoichiometry", "mole-ratio"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-CHEM-EN-L3-0008", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L3", "question": "What type of bond forms between sodium and chlorine in NaCl (table salt)?", "choices": {"A": "Covalent bond", "B": "Ionic bond", "C": "Metallic bond", "D": "Hydrogen bond"}, "answer": "B", "answer_short": null, "explanation": "The metal (Na) donates an electron and the nonmetal (Cl) accepts it, forming oppositely charged ions held by an ionic bond.", "tags": ["chemical-bond", "ionic"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L4-0009", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L4", "question": "For 2H2 + O2 → 2H2O, starting with 3 mol H2 and 2 mol O2, how many moles of water form?", "choices": {"A": "2", "B": "3", "C": "4", "D": "6"}, "answer": "B", "answer_short": null, "explanation": "3 mol H2 needs only 1.5 mol O2, so O2 is in excess and H2 is limiting. With H2:H2O = 1:1, 3 mol water forms.", "tags": ["limiting-reactant", "stoichiometry", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-CHEM-EN-L4-0010", "language": "en", "discipline": "Kimya", "format": "multiple_choice", "difficulty": "L4", "question": "40 g of NaOH is dissolved in 1 liter of water. What is the molar concentration? (molar mass of NaOH is 40 g/mol)", "choices": {"A": "0.5", "B": "1", "C": "2", "D": "40"}, "answer": "B", "answer_short": null, "explanation": "Moles = 40 / 40 = 1 mol; concentration = moles / volume = 1 / 1 = 1 mol/L.", "tags": ["concentration", "molarity", "multi-step"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
