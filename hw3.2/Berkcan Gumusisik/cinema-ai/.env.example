# ---- Cinema-AI ortam değişkenleri ----
# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizi girin.
#
#   cp .env.example .env
#
# Kod provider-agnostiktir: OpenAI-uyumlu herhangi bir endpoint çalışır.
# Varsayılan olarak Groq (ücretsiz) kullanılır.

# API anahtarı (Groq: https://console.groq.com/keys).
# BOŞ BIRAKILIRSA proje otomatik olarak yerel MOCK modeli kullanır:
# API'siz, kural tabanlı, tam tool-calling akışıyla geliştirme/test için idealdir.
LLM_API_KEY=

# Backend seçimi: auto | openai | mock
#   auto   -> anahtar varsa gerçek model, yoksa mock (varsayılan)
#   mock   -> her zaman yerel mock (API'siz test için zorla)
#   openai -> her zaman gerçek endpoint (anahtar zorunlu)
LLM_BACKEND=auto

# Opsiyonel: OpenAI-uyumlu endpoint. Boş bırakılırsa Groq kullanılır.
#   Groq        -> https://api.groq.com/openai/v1  (varsayılan)
#   OpenAI      -> https://api.openai.com/v1
#   HF Router   -> https://router.huggingface.co/v1
#   Yerel vLLM  -> http://localhost:8000/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Opsiyonel: Kullanılacak model. Tool-calling destekleyen bir model olmalı.
#   Groq   -> llama-3.3-70b-versatile (varsayılan)
#   OpenAI -> gpt-4o-mini
LLM_MODEL=llama-3.3-70b-versatile
