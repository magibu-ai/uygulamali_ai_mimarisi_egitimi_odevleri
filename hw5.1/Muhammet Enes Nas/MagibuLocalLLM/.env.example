# Bu dosyayi '.env' adiyla kopyalayin ve anahtarlarinizi doldurun.
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# ONEMLI: Hicbir anahtar ZORUNLU degildir. Bos birakirsaniz asistan calisir,
# sadece o servis yerine ucretsiz yedegi kullanilir.

# --- Web aramasi ---
# Tavily: LLM'ler icin tasarlanmis arama API'si. https://tavily.com (ucretsiz kota var)
# Bos birakilirsa: DuckDuckGo Lite -> Wikipedia yedegine duser.
TAVILY_API_KEY=

# --- Ollama ---
# Ollama baska bir makinede/portta calisiyorsa degistirin.
OLLAMA_HOST=http://localhost:11434

# Sohbet modeli. Arac cagirma (tool calling) destekleyen bir model olmali.
# 0.6b kucuk ve hizli ama arac secimini sik sasirir; gucunuz varsa qwen3:4b onerilir.
OLLAMA_CHAT_MODEL=qwen3:0.6b

# Bilgi bankasi aramasinda kullanilacak embedding modeli.
# Secenekler: magibu | gemma | bge   (bkz. ollama_client.EMBED_MODELS)
EMBED_MODEL=magibu

# Model GPU'da ne kadar bekletilsin. Kisa tutarsaniz her soruda yeniden yuklenir.
OLLAMA_KEEP_ALIVE=30m

# Baglam penceresi. Dusurmeyin: sistem istemi + arac semalari ~1500 token tutuyor.
OLLAMA_NUM_CTX=8192
