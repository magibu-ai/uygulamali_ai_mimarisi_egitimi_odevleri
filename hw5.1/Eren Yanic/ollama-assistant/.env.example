# Copy to .env and fill in. .env is git-ignored; this file is not, so keep it empty of real keys.

# Web search. Free tier: https://app.tavily.com
# Without it the assistant falls back to DuckDuckGo, which needs no key.
TAVILY_KEY=

# --- Everything below is optional; the defaults in config.py are used when unset. ---

# Ollama
# OLLAMA_HOST=http://localhost:11434
# CHAT_MODEL=qwen3:4b-instruct
# NUM_CTX=8192
# TEMPERATURE=0.3
# KEEP_ALIVE=10m

# Ask before running model-written Python. Turn this off at your own risk.
# CONFIRM_PYTHON=true

# Borsa MCP server. Point this at your own instance to keep queries off a third-party host.
# BORSA_MCP_URL=https://borsa.surucu.dev/mcp
