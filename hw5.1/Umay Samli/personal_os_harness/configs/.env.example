# Copy this file to configs/.env and replace local placeholders as needed.

OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOOL_ROUNDS=10

# Read-only web/weather requests are bounded and time out independently of Ollama.
EXTERNAL_TIMEOUT_SECONDS=15
EXTERNAL_MAX_RESPONSE_BYTES=1000000
EXTERNAL_MAX_TEXT_CHARACTERS=20000
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Keep the planning and memory databases separate, including their runtime roles.
PLANNING_DATABASE_URL=postgresql://planning_runtime:change-me@127.0.0.1:5432/personal_os_planning
MEMORY_DATABASE_URL=postgresql://memory_runtime:change-me@127.0.0.1:5432/personal_os_memory

PLANNING_TIMEZONE=Europe/Istanbul
SCHEDULING_RESOLUTION_MINUTES=15
FALLBACK_PERSONAL_RESERVE_MINUTES=720
DAILY_PROFILE_COMPLETE_DEFAULT=false
DEADLINE_BUFFER_MINUTES=0
PROPOSAL_TTL_MINUTES=30
REMINDER_DISPLAY_LIMIT=5
