# e-hekim — operator credentials.
#
# Copy to `.env` and fill in. `.env` is git-ignored and is excluded from the
# Hugging Face upload by scripts/push_to_hub.py.
#
# IMPORTANT: these are used ONLY by the offline scripts in scripts/ — dataset
# ingestion and the Hub upload. The web application never reads an LLM provider
# key from the environment; users supply their own key in the browser for each
# RAG request, and it is never persisted server-side.

# Needed by scripts/ingest.py (source dataset is gated) and scripts/push_to_hub.py.
# Create at https://huggingface.co/settings/tokens with write access.
HUGGINGFACE_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional. Only used by scripts/benchmark.py --with-rag to exercise the LLM
# path end to end. The web app does NOT read this value.
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
