# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling / test caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- Environment files ---
.env
.env.*

# --- Datasets: keep the folders, ignore their contents (raw/processed only) ---
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# --- Generated artifacts: keep the folder, ignore its contents ---
/artifacts/*
!/artifacts/.gitkeep

# --- Local ChromaDB persistence ---
/artifacts/chroma/

# NOTE:
# - data/benchmark/ is intentionally NOT ignored (academic deliverable).
# - Project documentation (CLAUDE.md, ROADMAP.md, PROMPT.md, ARCH.md,
#   README.md) is intentionally tracked.
